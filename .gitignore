# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Ignore local CUPS artifacts and custom driver PPD copied in repo
cups/
verbose-waffle/CNRCUPSIRADV45453ZK.ppd

# 실제 사용자 업로드와 로컬 검증 산출물은 저장소에 포함하지 않음
/temp/
/tmp/


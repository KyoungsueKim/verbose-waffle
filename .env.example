# 호스트 작업 파일 디렉터리와 bind source 생성 정책
# 기본값은 프로젝트의 로컬 ./temp이며 특정 파일시스템이나 mount를 요구하지 않는다.
# 이미 마운트되어 있어야 하는 외부 경로를 지정할 때는 false로 두어 경로 누락 시 즉시 실패시킨다.
PRINT_TEMP_HOST_DIR=./temp
PRINT_TEMP_BIND_CREATE_HOST_PATH=true

# 컨테이너 내부 입출력 경로
PRINT_TEMP_DIR=/temp
PRINT_OUTPUT_DIR=/root

# Canon UFR II CUPS 모델과 요청별 출력 정책
PRINT_CUPS_MODEL=CNRCUPSIRADV45453ZK.ppd
PRINT_CUPS_MEDIA_A4=A4
PRINT_CUPS_MEDIA_A3=A3
PRINT_CUPS_SCALING=auto-fit
PRINT_CUPS_JOB_TIMEOUT_SECONDS=180
PRINT_CUPS_POLL_INTERVAL_SECONDS=1
PRINT_CUPS_CLEANUP_TIMEOUT_SECONDS=10

# 현재 작업 파일 보존 동작을 유지한다.
PRINT_RETAIN_JOB_FILES=false

# 완료 로그에 포함할 장애 추적 정보(전화번호와 원본 PDF 파일명)
PRINT_LOG_PHONE_NUMBER=true
PRINT_LOG_FILE_NAME=true

# true이면 Compose의 주기적 CUPS/API healthcheck를 실행하지 않는다.
# /healthz 라우트는 수동 점검용으로 계속 유지된다.
PRINT_HEALTHCHECK_DISABLED=true

# 캠퍼스 서버 연결/응답 대기 제한(초)
PRINT_HTTP_CONNECT_TIMEOUT_SECONDS=10
PRINT_HTTP_READ_TIMEOUT_SECONDS=60

# 캠퍼스 프린트 서버 연동 값
PRINT_UPLOAD_BIN_URL=http://218.145.52.6:8080/spbs/upload_bin
PRINT_REGISTER_DOC_URL=http://u-printon.canon-bs.co.kr:62301/nologin/regist_doc/
PRINT_FRANCHISE_ID=28
